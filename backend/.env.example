# backend/.env 를 만들 때 이 파일을 복사해서 값을 채운다. 이 파일에는 값을 적지 않는다 (security.md 1번).

# 실행 환경: development 또는 production (production 이면 로그인 쿠키에 Secure 를 붙인다)
NODE_ENV=

# DB 접속 (database.md 1, D-034). 서버 이름 예: localhost / 인스턴스 예: SQLEXPRESS
# DB_PORT 를 적으면 인스턴스 대신 포트로 접속한다. 비워 두면 DB_INSTANCE 로 접속한다
DB_SERVER=
DB_INSTANCE=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Gmail SMTP 메일 발송 (D-004). MAIL_PASSWORD 는 Gmail 앱 비밀번호 16자리 (띄어쓰기 없이)
MAIL_USER=
MAIL_PASSWORD=

# 공공데이터포털 한국천문연구원 특일 정보 API 키 (D-107)
HOLIDAY_API_KEY=
