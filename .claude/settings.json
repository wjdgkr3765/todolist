{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.js\"",
            "timeout": 10,
            "statusMessage": "보호 파일 확인 중"
          }
        ]
      }
    ]
  }
}
